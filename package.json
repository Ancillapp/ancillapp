{
  "name": "ancillapp",
  "version": "2.3.0",
  "description": "Ancillapp",
  "author": "Giorgio Garasto <giorgio@garasto.me>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "bun run --workspaces start",
    "build": "bun run --workspaces build",
    "start:pwa": "bun --filter @ancillapp/pwa start",
    "build:pwa": "bun --filter @ancillapp/pwa run build",
    "start:functions": "bun --filter @ancillapp/functions start",
    "build:functions": "bun --filter @ancillapp/functions run build",
    "build:sitemap": "node scripts/sitemap"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "firebase-tools": "^14.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  },
  "workspaces": [
    "functions",
    "pwa"
  ],
  "packageManager": "bun@1.3.14"
}
